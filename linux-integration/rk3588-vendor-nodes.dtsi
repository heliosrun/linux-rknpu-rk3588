/* SPDX-License-Identifier: GPL-2.0
 * Vendor RKNPU node for in-tree builds - add to rk3588-base.dtsi.
 * Mutually exclusive with the rocket nodes (same MMIO): both default
 * to disabled. Unique node names avoid clashing with npu@fdab0000.
 *
 * NON-IOMMU MODE: no iommus property, on purpose. The RK3588 NPU
 * IOMMU is one device with four windows across three cores' clock
 * domains (BSP: six gates); the mainline rockchip-iommu driver
 * bulk-gets exactly two clocks (aclk/iface) and aborts on the
 * windows it cannot gate (observed on hardware: synchronous external
 * abort in rk_iommu_enable_stall). Per-window clock support in the
 * mainline driver is the proper fix; until then the vendor driver's
 * own non-iommu mode (physical DMA) is used. */
	rknpu: rknpu@fdab0000 {
		compatible = "rockchip,rk3588-rknpu";
		reg = <0x0 0xfdab0000 0x0 0x10000>,
		      <0x0 0xfdac0000 0x0 0x10000>,
		      <0x0 0xfdad0000 0x0 0x10000>;
		interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH 0>;
		interrupt-names = "npu0_irq", "npu1_irq", "npu2_irq";
		clocks = <&scmi_clk SCMI_CLK_NPU>, <&cru ACLK_NPU0>,
			 <&cru ACLK_NPU1>, <&cru ACLK_NPU2>,
			 <&cru HCLK_NPU0>, <&cru HCLK_NPU1>,
			 <&cru HCLK_NPU2>, <&cru PCLK_NPU_ROOT>;
		clock-names = "clk_npu", "aclk0",
			      "aclk1", "aclk2",
			      "hclk0", "hclk1",
			      "hclk2", "pclk";
		assigned-clocks = <&scmi_clk SCMI_CLK_NPU>;
		/* Defaults run before power-up: only the 200 MHz GPLL path
		 * is safe here. Higher rates need driver-managed sequencing. */
		assigned-clock-rates = <200000000>;
		resets = <&cru SRST_A_RKNN0>, <&cru SRST_A_RKNN1>,
			 <&cru SRST_A_RKNN2>,
			 <&cru SRST_H_RKNN0>, <&cru SRST_H_RKNN1>,
			 <&cru SRST_H_RKNN2>;
		reset-names = "srst_a0", "srst_a1", "srst_a2",
			      "srst_h0", "srst_h1", "srst_h2";
		power-domains = <&power RK3588_PD_NPUTOP>,
				<&power RK3588_PD_NPU1>,
				<&power RK3588_PD_NPU2>;
		power-domain-names = "npu0", "npu1", "npu2";
		status = "disabled";
	};
