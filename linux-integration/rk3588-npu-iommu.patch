+++ b/Documentation/devicetree/bindings/iommu/rockchip,rk3588-rknpu-iommu.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iommu/rockchip,rk3588-rknpu-iommu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: Rockchip RK3588 four-bank NPU IOMMU
+maintainers:
+  - Heiko Stuebner <heiko@sntech.de>
+description: |
+  One DMA translation domain spans the two NPU0 MMUs and the NPU1/NPU2 MMUs.
+  Each bank must be powered and clocked by the IOMMU supplier itself, even
+  when a consumer has not probed or is suspended.
+properties:
+  compatible:
+    const: rockchip,rk3588-rknpu-iommu
+  reg:
+    items:
+      - description: NPU0 first MMU (0xfdab9000)
+      - description: NPU0 second MMU (0xfdaba000)
+      - description: NPU1 MMU (0xfdaca000)
+      - description: NPU2 MMU (0xfdada000)
+  interrupts:
+    maxItems: 3
+    minItems: 3
+  clocks:
+    maxItems: 6
+    minItems: 6
+  clock-names:
+    items:
+      - const: aclk0
+      - const: iface0
+      - const: aclk1
+      - const: iface1
+      - const: aclk2
+      - const: iface2
+  power-domains:
+    maxItems: 3
+    minItems: 3
+  power-domain-names:
+    items:
+      - const: npu0
+      - const: npu1
+      - const: npu2
+  "#iommu-cells":
+    const: 0
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - power-domains
+  - power-domain-names
+  - "#iommu-cells"
+additionalProperties: false
